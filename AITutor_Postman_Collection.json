                {
                    "name": "Register",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                                    "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                                    "}",
                                    "if (jsonData && jsonData.data && jsonData.data.user && jsonData.data.user.userId) {",
                                    "    pm.collectionVariables.set(\"userId\", jsonData.data.user.userId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"student123\",\n    \"email\": \"student123@example.com\",\n    \"password\": \"Password1!\",\n    \"confirmPassword\": \"Password1!\",\n    \"fullName\": \"Student Name\",\n    \"phoneNumber\": \"0987654321\",\n    \"schoolName\": \"High School A\",\n    \"gradeLevel\": \"10\",\n    \"className\": \"10A1\"\n}"
