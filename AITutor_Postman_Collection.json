                            ]
                        }
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{accessToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"fullName\": \"Student New Name\",\n    \"phoneNumber\": \"0326999705\",\n    \"dateOfBirth\": \"2000-01-01\",\n    \"gender\": \"MALE\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
