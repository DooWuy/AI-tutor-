# Local development environment. Do not put production secrets here.

# PostgreSQL
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Mail (optional for local development)
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_app_password

# Cloudinary - required for successful avatar upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI (required only for AI features)
GEMINI_API_KEY=your_gemini_api_key

# Optional frontend URL override
APP_FRONTEND_URL=http://localhost:3000

# Optional auth settings
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=86400000
